{
  "name": "coc-test",
  "version": "0.1.2",
  "description": "Integration test runner for coc.nvim extensions",
  "type": "module",
  "bin": {
    "coc-test": "bin/coc-test"
  },
  "files": [
    "bin/coc-test",
    "lib/**/*.js"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:nvim": "npm run build && node test/run.js --nvim",
    "test:vim": "npm run build && node test/run.js --vim"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "rolldown": "^1.0.0-beta.36"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.0"
  }
}
